{
  "name": "wms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --prefix server run dev",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && npm --prefix server run typecheck",
    "start": "npm --prefix server run start"
  },
  "dependencies": {
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
