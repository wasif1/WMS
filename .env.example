# --- Required in production -------------------------------------------------------------
NODE_ENV=production
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this in a secret manager, separate from the database and backups. Losing it = losing the data.
WMS_MASTER_KEY=
# Public origin of the app (used for the CSRF origin check), e.g. https://wms.example.com
WMS_ORIGIN=
# Reverse-proxy hops in front of the app (1 for nginx/Caddy) so client IPs / rate limits are right
WMS_TRUST_PROXY=1

# --- Optional ---------------------------------------------------------------------------
PORT=4000
WMS_DATA_DIR=./server/data            # DB lives here (chmod 700). Also put it on an encrypted volume.
WMS_BACKUP_DIR=./server/data/backups
WMS_BACKUP_KEEP=3
WMS_BACKUP_CRON="0 2 * * 0"           # weekly Sun 02:00.  Monthly: "0 2 1 * *"   Daily: "0 2 * * *"
WMS_REQUIRE_MFA=false                 # true = every user must enrol TOTP before using the system
WMS_SESSION_IDLE_MIN=30
WMS_SESSION_MAX_HOURS=8
WMS_SMTP_URL=                         # e.g. smtps://user:pass@smtp.example.com
WMS_MAIL_FROM="WMS <no-reply@example.com>"
